{
  "rules": {
    ".read": false,
    ".write": false,
    "r": {
      "$ruimte": {
        ".read": "$ruimte.length == 32",
        ".write": "$ruimte.length == 32",
        "$soort": {
          ".validate": "$soort.matches(/^[a-z]{3,16}$/)",
          "$id": {
            ".validate": "newData.child('v').isString() && newData.child('v').val().length < 1000000 && newData.child('t').isNumber()"
          }
        }
      }
    },
    "g": {
      "$kamer": {
        ".read": "$kamer.length == 32",
        ".write": "$kamer.length == 32",
        "$soort": {
          ".validate": "$soort == 'p' || $soort == 'm'",
          "$id": {
            ".validate": "newData.child('v').isString() && newData.child('v').val().length < 200000 && newData.child('t').isNumber()"
          }
        }
      }
    },
    "s": {
      "$ruimte": {
        ".read": "$ruimte.length == 32",
        ".write": "$ruimte.length == 32",
        "$bestand": {
          "$deel": {
            ".validate": "newData.child('v').isString() && newData.child('v').val().length < 3000000"
          }
        }
      }
    },
    "p": {
      "$ruimte": {
        ".read": "$ruimte.length == 32",
        "$soort": {
          "$id": {
            ".write": "$ruimte.length == 32 && $soort.matches(/^[a-z]{3,16}$/) && $id.length <= 64 && !data.exists() && newData.exists()",
            ".validate": "newData.hasChildren(['v', 't']) && newData.child('v').isString() && newData.child('v').val().length < 1000000 && newData.child('t').val() == now",
            "$veld": {
              ".validate": "$veld == 'v' || $veld == 't'"
            }
          }
        }
      }
    }
  }
}
